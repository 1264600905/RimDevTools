<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- 30毫米海军炮塔枪口火焰效果补丁 -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Muzzle Flash</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<!-- AK-230 转膛式防空炮枪口火焰效果 -->
				<li Class="SafePatcher.PatchOperationSetModExtension">
					<xpath>Defs/ThingDef[defName="AK230_Gun"]</xpath>
					<value>
						<li Class="MuzzleFlash.MuzzleFlashProps">
							<def>MF_StandardMuzzleFalsh</def>
							<drawSize>(1.2,1.2)</drawSize>
							<offsets>
								<li>(2.4,0.15)</li>
                                <li>(2.4,-0.2)</li>
							</offsets>
							<isAlternately>true</isAlternately>
						</li>
					</value>
				</li>
				
				<!-- AK-630M2 双联装近防武器枪口火焰效果 -->
				<li Class="SafePatcher.PatchOperationSetModExtension">
					<xpath>Defs/ThingDef[defName="AK630M2_Gun"]</xpath>
					<value>
						<li Class="MuzzleFlash.MuzzleFlashProps">
							<def>MF_StandardMuzzleFalshTwo</def>
							<drawSize>(1.5,1.5)</drawSize>
							<offsets>
								<li>(1.8,0)</li>
							</offsets>
							<isAlternately>true</isAlternately>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
