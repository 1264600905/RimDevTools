<TestSuite schemaVersion="1" id="batch1.core" packageId="ludeon.rimworld" gameVersion="1.7">
  <Requirements><DLC packageId="ludeon.rimworld.anomaly" /></Requirements>
  <Templates>
    <PawnTemplate id="human"><basePawnKind>SpaceRefugee</basePawnKind><minGenerationAge>25</minGenerationAge><maxGenerationAge>25</maxGenerationAge></PawnTemplate>
    <PawnTemplate id="caster" extends="human">
      <Apparel mode="patch"><Replace matchLayer="Overhead" withDef="Apparel_CowboyHat" stuff="Cloth" quality="Normal" onMissing="add" /></Apparel>
      <Equipment mode="patch"><SetPrimary def="Gun_Autopistol" quality="Good" /></Equipment>
      <Traits mode="patch"><Set def="Tough" degree="0" /></Traits>
      <Skills mode="patch"><Set def="Shooting" level="14" passion="Major" /></Skills>
      <Hediffs mode="patch"><Ensure def="Metalblood" severity="1" /></Hediffs>
      <Abilities mode="patch"><Ensure def="MetalbloodInjection" /></Abilities>
    </PawnTemplate>
  </Templates>
  <Case id="full" seed="31981" timeoutRealSeconds="90">
    <testDefName>Batch1_NativeMetalblood</testDefName>
    <Targets><Def defType="AbilityDef" defName="MetalbloodInjection" /><Def defType="ThingDef" defName="Gun_Autopistol" /></Targets>
    <Scene type="pocketMap" sizeX="50" sizeZ="50" revealFog="all" />
    <Teams><Team id="ours" factionDef="player" /></Teams>
    <Actors>
      <Pawn id="caster" template="caster" team="ours" x="20" z="24" />
      <PawnGroup id="friends" template="human" team="ours" count="2" originX="25" originZ="24" spacing="3" />
      <Building id="wall" def="Wall" stuff="Steel" x="20" z="18" />
      <Building id="light" def="GlowPod" x="20" z="23" />
      <Thing id="steel" def="Steel" count="25" x="22" z="18" />
      <Corpse id="body" template="human" x="25" z="18" />
      <DefRef id="recipe" defType="RecipeDef" defName="Make_StoneBlocksAny" />
      <TerrainArea id="soil" def="Soil" x="30" z="30" width="2" height="2" />
    </Actors>
    <Steps>
      <Require id="prepared-check"><All>
        <ActorCount group="friends" equals="2" /><Equipped actor="caster" def="Gun_Autopistol" />
        <ActorState actor="friends" state="alive" quantifier="all" />
        <HasTrait actor="caster" def="Tough" degree="0" /><SkillLevel actor="caster" def="Shooting" min="14" max="14" />
        <Wearing actor="caster" def="Apparel_CowboyHat" />
        <HasHediff actor="caster" def="Metalblood" /><CorpseState actor="body" state="valid" />
        <ActorState actor="body.innerPawn" state="dead" /><ThingExists actor="steel" def="Steel" />
      </All></Require>
      <RemoveHediff id="clear-existing" actor="caster" def="Metalblood" />
      <Require id="removed"><HasHediff actor="caster" def="Metalblood" transition="removed" since="prepared" /></Require>
      <Checkpoint id="ready-to-cast" />
      <CastAbility id="cast" actor="caster" def="MetalbloodInjection" target="caster" force="false" />
      <Wait id="effect" timeoutRealSeconds="5" stableTicks="2"><HasHediff actor="caster" def="Metalblood" transition="added" since="cast" observation="eventually" /></Wait>
      <Screenshot id="effect-image" focus="caster" />
      <Checkpoint id="before-drop" />
      <DropEquipment id="drop" actor="caster" />
      <Require id="not-created-by-drop"><Not><ThingExists def="Gun_Autopistol" transition="added" since="before-drop" /></Not></Require>
      <CreateThing id="create-new" def="Gun_Autopistol" x="21" z="21" />
      <Require id="new-identity"><ThingExists def="Gun_Autopistol" transition="added" since="before-drop" /></Require>
      <Checkpoint id="transient-baseline" />
      <AddHediff id="short-effect" actor="friends[0]" def="Metalblood" severity="1" durationTicks="1" />
      <Wait id="observed-transient" timeoutRealSeconds="5"><HasHediff actor="friends[0]" def="Metalblood" transition="added" since="transient-baseline" observation="eventually" /></Wait>
      <Wait id="transient-expired" timeoutRealSeconds="5"><Not><HasHediff actor="friends[0]" def="Metalblood" /></Not></Wait>
    </Steps>
    <Success><All><StepSucceeded ref="cast" /><StepSucceeded ref="effect" /><StepSucceeded ref="effect-image" /><CorpseState actor="body" state="valid" /></All></Success>
  </Case>
  <Case id="independent" seed="31981">
    <testDefName>Batch1_SameTargetIndependentRule</testDefName>
    <Targets><Def defType="AbilityDef" defName="MetalbloodInjection" /></Targets>
    <Scene type="pocketMap" sizeX="50" sizeZ="50" />
    <Teams><Team id="npc" factionDef="AncientsHostile" /></Teams>
    <Actors><Pawn id="pawn" template="human" team="npc" x="20" z="20" /></Actors>
    <Steps><Require id="alive"><ActorState actor="pawn" state="alive" /></Require></Steps>
    <Success><StepSucceeded ref="alive" /></Success>
  </Case>
</TestSuite>
