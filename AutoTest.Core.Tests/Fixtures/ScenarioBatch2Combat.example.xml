<?xml version="1.0" encoding="utf-8"?>
<TestSuite schemaVersion="1" id="batch2.ranged" packageId="ludeon.rimworld" gameVersion="1.7">
  <Case id="ranged-damage" name="自定义远程命中与替代矩阵" caseType="RangedWeaponPocketMap" seed="31981" timeoutRealSeconds="90">
    <testDefName>Batch2_RangedDamage</testDefName>
    <Matrix>
      <Row id="autopistol"><Param name="weapon" value="Gun_Autopistol" /></Row>
      <Row id="revolver"><Param name="weapon" value="Gun_Revolver" /></Row>
    </Matrix>
    <Coverage mode="replace">
      <Target defType="ThingDef" defName="${weapon}" caseType="RangedWeaponPocketMap"><Evidence step="damage" /></Target>
    </Coverage>
    <Scene type="pocketMap" sizeX="50" sizeZ="50" revealFog="all" />
    <Teams><Team id="allies" factionDef="player" /><Team id="enemy" factionDef="AncientsHostile" /></Teams>
    <Actors>
      <Pawn id="shooter" team="allies" x="15" z="20">
        <basePawnKind>SpaceRefugee</basePawnKind><minGenerationAge>25</minGenerationAge><maxGenerationAge>25</maxGenerationAge>
        <Skills><Set def="Shooting" level="20" /></Skills>
        <Equipment mode="replace"><SetPrimary def="${weapon}" quality="Normal" /></Equipment>
      </Pawn>
      <Building id="target" def="Wall" stuff="Steel" team="enemy" x="21" z="20" />
    </Actors>
    <Steps>
      <DebugAction id="needs" actionId="native.fillNeeds"><Select mode="single" actor="shooter" /></DebugAction>
      <Require id="prepared-check"><Equipped actor="shooter" def="${weapon}" /><NeedLevel actor="shooter" def="Food" min="0.9" /></Require>
      <Attack id="shoot" actor="shooter" target="target" timeoutRealSeconds="10" />
      <Wait id="damage" timeoutRealSeconds="20"><HealthPercent actor="target" max="0.99" /></Wait>
      <Screenshot id="hit-image" focus="target" />
    </Steps>
    <Success><All><StepSucceeded ref="prepared-check" /><StepSucceeded ref="damage" /><StepSucceeded ref="hit-image" /></All></Success>
  </Case>
</TestSuite>
