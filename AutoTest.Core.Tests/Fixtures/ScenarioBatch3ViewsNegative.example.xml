<?xml version='1.0' encoding='utf-8'?>
<TestSuite schemaVersion="1" id="batch3.views.controlled-failures" packageId="ludeon.rimworld">
  <Templates>
    <PawnTemplate id="presenter">
      <basePawnKind>SpaceRefugee</basePawnKind>
      <gender>Male</gender>
      <Age biologicalYears="25" chronologicalYears="25" />
      <Appearance>
        <hair>Shaved</hair>
        <bodyType>Male</bodyType>
        <headType>Male_AverageNormal</headType>
        <hairColor>#241810</hairColor>
      </Appearance>
      <Apparel mode="replace">
        <Add def="Apparel_Pants" stuff="Cloth" quality="Good" />
        <Add def="Apparel_BasicShirt" stuff="Cloth" quality="Good" />
        <Add def="Apparel_FlakVest" quality="Excellent" />
        <Add def="Apparel_SimpleHelmet" stuff="Steel" quality="Excellent" />
      </Apparel>
      <Equipment>
        <SetPrimary def="Gun_AssaultRifle" quality="Excellent" />
      </Equipment>
    </PawnTemplate>
  </Templates>
  <Case id="loadout-negative" caseType="LoadoutView" timeoutRealSeconds="90">
    <testDefName>Batch3_CompleteLoadout_WrongExpectation</testDefName>
    <Scene />
    <Actors>
      <Pawn id="p" template="presenter" x="25" z="25" />
    </Actors>
    <Steps>
      <Require id="configured">
        <Equipped actor="p" def="Gun_AssaultRifle" />
        <Wearing actor="p" def="Apparel_FlakVest" />
        <PawnAppearance actor="p" property="hair" value="Shaved" />
      </Require>
      <View id="loadout" actor="p" directions="South,East,North,West" pose="weaponReady" loadout="preserve" cameraSize="11" />
      <Require id="retained">
        <Equipped actor="p" def="Gun_AssaultRifle" />
        <Wearing actor="p" def="Apparel_FlakVest" />
        <Wearing actor="p" def="Apparel_SimpleHelmet" />
      </Require>
      <Require id="controlled-failure">
        <ThingExists actor="p" def="ComponentIndustrial" />
      </Require>
    </Steps>
    <Success>
      <StepSucceeded ref="loadout" />
      <StepSucceeded ref="retained" />
    </Success>
  </Case>
