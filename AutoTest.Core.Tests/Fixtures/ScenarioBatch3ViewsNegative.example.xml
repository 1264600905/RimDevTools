  </Case>
  <Case id="plant-negative" caseType="PlantGrowthView" timeoutRealSeconds="90">
    <testDefName>Batch3_RiceStages_WrongExpectation</testDefName>
    <Scene />
    <Actors>
      <Thing id="plant" def="Plant_Rice" growth="0.2" x="25" z="25" />
    </Actors>
    <Steps>
      <Require id="young">
        <PlantGrowth actor="plant" min="0.19" max="0.21" />
      </Require>
      <View id="young-image" actor="plant" directions="South" cameraSize="11" />
      <SetPlantGrowth id="grow" actor="plant" value="1" />
      <Require id="mature">
        <PlantGrowth actor="plant" min="1" max="1" />
      </Require>
      <View id="mature-image" actor="plant" directions="South" cameraSize="11" />
      <Require id="controlled-failure">
        <ThingExists actor="plant" def="ComponentIndustrial" />
      </Require>
    </Steps>
    <Success>
      <StepSucceeded ref="young-image" />
      <StepSucceeded ref="mature-image" />
    </Success>
  </Case>
