<ArenaSuite schemaVersion="1" id="arena.bossChallenges" gameVersion="1.7">
  <SquadTemplates>
    <SquadTemplate id="mercenaries" source="custom" factionDef="Pirate">
      <Composition mode="fixed">
        <Member pawnKind="Mercenary_Gunner" count="1"/>
        <Member pawnKind="Mercenary_Heavy" count="1"/>
      </Composition>
    </SquadTemplate>
  </SquadTemplates>
  <Tournament id="roundRobin" name="魔王轮战：双魔王与双对手" format="bossRoundRobin" seed="12345">
    <testDefName>Arena_BossRoundRobin</testDefName>
    <Scene type="mainMap" generatorDef="LogSync_AutoTestStudioMap" sizeX="100" sizeZ="100" revealFog="all">
      <Environment weather="Clear" temperature="21" roof="none" naturalSun="true"/>
    </Scene>
    <Roster mode="count" count="1"/>
    <Entrants>
      <Entrant id="boss-wolf" pawnKind="Wolf_Timber" role="boss" name="狼魔王"/>
      <Entrant id="boss-rat" pawnKind="Rat" role="boss" name="鼠魔王"/>
      <Entrant id="rat" pawnKind="Rat" role="challenger" name="鼠挑战者"/>
      <Entrant id="wolves" pawnKind="Wolf_Timber" count="2" role="challenger" name="双狼挑战者"/>
    </Entrants>
    <Battle timeSpeed="superfast" durationSeconds="90" timeoutRealSeconds="180" confirmationTicks="60"/>
    <TieBreak maxReplays="1"/>
    <Presentation><Showcase pageSeconds="3"/></Presentation>
    <Output width="1280" height="720"/>
  </Tournament>
