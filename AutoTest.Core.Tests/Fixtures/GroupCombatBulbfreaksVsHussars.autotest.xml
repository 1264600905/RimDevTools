<TestSuite schemaVersion="1" id="benchmark.bulbfreaks-hussars" gameVersion="1.7">
  <Templates>
    <PawnTemplate id="charge-centipede">
      <basePawnKind>Mech_CentipedeBlaster</basePawnKind>
      <Hediffs mode="replace" />
    </PawnTemplate>
    <PawnTemplate id="bulbfreak">
      <basePawnKind>Bulbfreak</basePawnKind>
      <Hediffs mode="replace" />
    </PawnTemplate>
    <PawnTemplate id="thrumbo">
      <basePawnKind>Thrumbo</basePawnKind>
      <Hediffs mode="replace" />
    </PawnTemplate>
    <PawnTemplate id="hussar-knight">
      <basePawnKind>Colonist</basePawnKind>
      <minGenerationAge>25</minGenerationAge>
      <maxGenerationAge>25</maxGenerationAge>
      <Xenotype def="Hussar" />
      <Traits mode="replace">
        <Set def="Tough" degree="0" />
        <Set def="ShootingAccuracy" degree="-1" />
      </Traits>
      <Skills mode="patch">
        <Set def="Shooting" level="10" passion="None" />
      </Skills>
      <Apparel mode="replace">
        <Add def="Apparel_ArmorCataphract" quality="Normal" />
        <Add def="Apparel_ArmorHelmetCataphract" quality="Normal" />
      </Apparel>
      <Equipment mode="replace">
        <SetPrimary def="Gun_ChargeRifle" quality="Normal" />
      </Equipment>
      <Hediffs mode="replace">
        <Ensure def="Metalblood" severity="1" />
      </Hediffs>
    </PawnTemplate>
  </Templates>
  <Case id="arena-base" kind="groupCombat" seed="12345" timeoutRealSeconds="300" abstract="true">
    <Scene type="mainMap" generatorDef="LogSync_AutoTestStudioMap" sizeX="100" sizeZ="100" revealFog="all">
      <Environment weather="Clear" temperature="21" roof="none" naturalSun="true" />
    </Scene>
    <Teams>
      <Team id="A" name="电荷蜈蚣" />
      <Team id="B" name="钢血骑士甲骠骑种" />
    </Teams>
    <Actors>
      <PawnGroup id="left" template="charge-centipede" team="A" count="20" originX="22" originZ="40" formation="grid" columns="4" spacing="3" />
      <PawnGroup id="hussars" template="hussar-knight" team="B" count="20" originX="62" originZ="40" formation="grid" columns="4" spacing="3" />
    </Actors>
    <Steps>
      <Require id="roster-and-loadout">
        <All>
          <ActorCount group="left" equals="20" />
          <ActorCount group="hussars" equals="20" />
          <HasXenotype actor="hussars" def="Hussar" />
          <SkillLevel actor="hussars" def="Shooting" min="10" max="10" />
          <HasTrait actor="hussars" def="Tough" degree="0" />
          <HasTrait actor="hussars" def="ShootingAccuracy" degree="-1" />
          <Wearing actor="hussars" def="Apparel_ArmorCataphract" />
          <Wearing actor="hussars" def="Apparel_ArmorHelmetCataphract" />
          <Equipped actor="hussars" def="Gun_ChargeRifle" />
          <HasHediff actor="hussars" def="Metalblood" quantifier="all" />
        </All>
      </Require>
    </Steps>
    <GroupCombat durationSeconds="180" timeSpeed="normal" />
    <Output purpose="benchmark" showAllParticipants="true" />
  </Case>
  <Case id="centipedes" extends="arena-base" name="20电荷蜈蚣对20钢血骑士甲骠骑电荷步枪手">
    <testDefName>Centipedes20VsHussars20_ChargeRifle</testDefName>
  </Case>
  <Case id="bulbfreaks" extends="centipedes" name="20恶臭瘤兽对20钢血骑士甲骠骑电荷步枪手">
    <testDefName>Bulbfreaks20VsHussars20_ChargeRifle</testDefName>
    <Actors>
      <PawnGroup id="left" template="bulbfreak" />
    </Actors>
    <Patches>
      <SetAttribute xpath="Teams/Team[@id='A']" name="name" value="恶臭瘤兽" />
    </Patches>
  </Case>
  <Case id="thrumbos" extends="bulbfreaks" name="10敲击兽对20钢血骑士甲骠骑电荷步枪手">
    <testDefName>Thrumbos10VsHussars20_ChargeRifle</testDefName>
    <Actors>
      <PawnGroup id="left" template="thrumbo" count="10" />
    </Actors>
    <Patches>
      <SetAttribute xpath="Teams/Team[@id='A']" name="name" value="敲击兽" />
      <SetAttribute xpath="Steps/Require[@id='roster-and-loadout']/All/ActorCount[@group='left']" name="equals" value="10" />
    </Patches>
  </Case>
  <Case id="elite-case1" extends="arena-base" name="一级精英骠骑电荷步枪手1对2">
    <testDefName>EliteL1Hussar1VsHussars2_ChargeRifle</testDefName>
    <Requirements>
      <Mod packageId="trigger.eliteraidplus" />
    </Requirements>
    <Actors>
      <PawnGroup id="left" template="hussar-knight" count="1" />
      <PawnGroup id="hussars" count="2" />
    </Actors>
    <Steps>
      <DebugAction id="apply-elite" actionId="eliteRaidPlus.applyElite" level="1">
        <Select mode="single" actor="left[0]" />
      </DebugAction>
      <Require id="elite-loadout">
        <All>
          <HasXenotype actor="left" def="Hussar" />
          <Equipped actor="left" def="Gun_ChargeRifle" />
          <HasHediff actor="left" def="Metalblood" quantifier="all" />
        </All>
      </Require>
    </Steps>
    <Patches>
      <SetAttribute xpath="Teams/Team[@id='A']" name="name" value="一级精英骠骑电荷步枪手" />
      <SetAttribute xpath="Steps/Require[@id='roster-and-loadout']/All/ActorCount[@group='left']" name="equals" value="1" />
      <SetAttribute xpath="Steps/Require[@id='roster-and-loadout']/All/ActorCount[@group='hussars']" name="equals" value="2" />
    </Patches>
  </Case>
  <Case id="elite-case2" extends="elite-case1" name="二级精英骠骑电荷步枪手1对4">
    <testDefName>EliteL2Hussar1VsHussars4_ChargeRifle</testDefName>
    <Actors>
      <PawnGroup id="hussars" count="4" />
    </Actors>
    <Patches>
      <SetAttribute xpath="Teams/Team[@id='A']" name="name" value="二级精英骠骑电荷步枪手" />
      <SetAttribute xpath="Steps/DebugAction[@id='apply-elite']" name="level" value="2" />
      <SetAttribute xpath="Steps/Require[@id='roster-and-loadout']/All/ActorCount[@group='hussars']" name="equals" value="4" />
    </Patches>
  </Case>
</TestSuite>
