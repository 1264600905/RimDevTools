  <Case id="recipe-negative" caseType="RecipeExecution" timeoutRealSeconds="90">
    <testDefName>Batch2_StonecuttingProductsAndConsumption_ExpectedAssertionFailure</testDefName>
    <Targets>
      <Def defType="RecipeDef" defName="Make_StoneBlocksAny" />
    </Targets>
    <Scene />
    <Teams>
      <Team id="player" factionDef="player" />
    </Teams>
    <Actors>
      <Pawn id="worker" team="player" x="15" z="20">
        <basePawnKind>SpaceRefugee</basePawnKind>
        <Skills>
          <Set def="Crafting" level="12" />
        </Skills>
      </Pawn>
      <Building id="bench" def="TableStonecutter" stuff="Steel" team="player" x="18" z="20" />
      <Thing id="chunk" def="ChunkGranite" x="20" z="20" />
    </Actors>
    <Steps>
      <Require id="expected-failure">
        <ActorState actor="bench" state="destroyed" />
      </Require>
      <ExecuteRecipe id="produce" actor="worker" worktable="bench" recipe="Make_StoneBlocksAny" output="products" accelerate="true">
        <Ingredients>
          <Ingredient actor="chunk" count="1" />
        </Ingredients>
      </ExecuteRecipe>
      <Require id="verify">
        <ThingQuantity actor="products" def="BlocksGranite" min="20" max="20" />
        <ActorState actor="chunk" state="destroyed" />
        <ThingExists def="BlocksGranite" transition="added" since="produce" />
      </Require>
      <Screenshot id="recipe-image" focus="bench" />
    </Steps>
    <Success>
      <StepSucceeded ref="verify" />
      <StepSucceeded ref="recipe-image" />
    </Success>
  </Case>
  <Case id="health-negative" caseType="HediffEffect" timeoutRealSeconds="60">
    <testDefName>Batch2_HediffSeverityAndRemoval_ExpectedAssertionFailure</testDefName>
    <Scene />
    <Actors>
      <Pawn id="patient" x="20" z="20">
        <basePawnKind>SpaceRefugee</basePawnKind>
      </Pawn>
    </Actors>
    <Steps>
      <Require id="expected-failure">
        <ActorState actor="patient" state="destroyed" />
      </Require>
      <AddHediff def="AlcoholHigh" severity="0.2" id="add" actor="patient" />
      <Require id="present">
        <HasHediff def="AlcoholHigh" severityMin="0.19" severityMax="0.21" transition="added" since="add" actor="patient" />
      </Require>
      <RemoveHediff def="AlcoholHigh" id="remove" actor="patient" />
      <Require id="removed">
        <HasHediff def="AlcoholHigh" transition="removed" since="remove" actor="patient" />
      </Require>
    </Steps>
    <Success>
      <StepSucceeded ref="present" />
      <StepSucceeded ref="removed" />
    </Success>
  </Case>
  <Case id="corpse-negative" caseType="CorpseLifecycle" timeoutRealSeconds="90">
    <testDefName>Batch2_CorpseRotAndSamePawnResurrection_ExpectedAssertionFailure</testDefName>
    <Scene />
    <Actors>
      <Corpse id="corpse" x="20" z="20">
        <basePawnKind>SpaceRefugee</basePawnKind>
      </Corpse>
    </Actors>
    <Steps>
      <Require id="expected-failure">
        <ActorState actor="corpse" state="destroyed" />
      </Require>
      <Require id="dead">
        <ActorState actor="corpse.innerPawn" state="dead" />
        <CorpseState actor="corpse" state="valid" />
      </Require>
      <SetRot id="rot" actor="corpse" state="Rotting" />
      <Require id="rotten">
        <ComponentState actor="corpse" component="rot" state="Rotting" />
      </Require>
      <Resurrect id="revive" actor="corpse" />
      <Require id="alive">
        <ActorState actor="corpse.innerPawn" state="alive" />
        <ActorState actor="corpse.innerPawn" state="spawned" />
        <CorpseState actor="corpse" state="destroyed" />
      </Require>
      <Screenshot id="resurrection-image" focus="corpse.innerPawn" />
    </Steps>
    <Success>
      <StepSucceeded ref="rotten" />
      <StepSucceeded ref="alive" />
    </Success>
  </Case>
  <Case id="inventory-negative" caseType="ThingBehavior" timeoutRealSeconds="90">
    <testDefName>Batch2_InventoryPreservesThingIdentity_ExpectedAssertionFailure</testDefName>
    <Scene />
    <Actors>
      <Pawn id="pawn" x="20" z="20">
        <basePawnKind>SpaceRefugee</basePawnKind>
      </Pawn>
      <Thing id="steel" def="Steel" count="25" x="22" z="20" />
    </Actors>
    <Steps>
      <Require id="expected-failure">
        <ActorState actor="steel" state="destroyed" />
      </Require>
      <TransferThing id="take" actor="steel" target="pawn" />
      <Require id="held">
        <ThingHeld actor="steel" target="pawn" />
        <ThingQuantity actor="steel" def="Steel" min="25" max="25" />
      </Require>
      <Checkpoint id="before-drop" />
      <DropInventory id="drop" actor="pawn" target="steel" />
      <Require id="same">
        <ActorState actor="steel" state="spawned" />
        <Not>
          <ThingExists def="Steel" transition="added" since="before-drop" />
        </Not>
      </Require>
      <Destroy id="destroy" actor="steel" />
      <Require id="gone">
        <ActorState actor="steel" state="destroyed" />
      </Require>
    </Steps>
    <Success>
      <StepSucceeded ref="held" />
      <StepSucceeded ref="same" />
      <StepSucceeded ref="gone" />
    </Success>
  </Case>
  <Case id="intervention" timeoutRealSeconds="60">
    <testDefName>Batch2_ExpectedDebugInterferenceRejection</testDefName>
    <Scene /><Actors><Pawn id="p" x="20" z="20"><basePawnKind>SpaceRefugee</basePawnKind></Pawn></Actors>
    <Steps>
      <Checkpoint id="cast-baseline" />
      <DebugAction id="injection" actionId="native.addHediff" def="AlcoholHigh" severity="0.2"><Select mode="single" actor="p" /></DebugAction>
      <Require id="not-a-skill-effect"><HasHediff actor="p" def="AlcoholHigh" transition="added" since="cast-baseline" /></Require>
    </Steps>
    <Success><StepSucceeded ref="not-a-skill-effect" /></Success>
  </Case>
  <Case id="debug-postcondition" timeoutRealSeconds="60">
    <testDefName>Batch2_ExpectedDebugPostconditionFailure</testDefName>
    <Scene /><Actors><Pawn id="p" x="20" z="20"><basePawnKind>SpaceRefugee</basePawnKind></Pawn></Actors>
    <Steps><DebugAction id="exact-severity" actionId="native.addHediff" def="Anesthetic" severity="1000"><Select mode="single" actor="p" /></DebugAction></Steps>
    <Success><StepSucceeded ref="exact-severity" /></Success>
  </Case>
  <Case id="unused-coverage" timeoutRealSeconds="60">
    <testDefName>Batch2_ExpectedUnusedCoverageTarget</testDefName>
    <Coverage mode="supplement"><Target packageId="ludeon.rimworld.anomaly" defType="AbilityDef" defName="MetalbloodInjection" caseType="SkillPocketMap"><Evidence step="owned" /></Target></Coverage>
    <Scene /><Actors><Pawn id="p" x="20" z="20"><basePawnKind>SpaceRefugee</basePawnKind><Abilities><Ensure def="MetalbloodInjection" /></Abilities></Pawn></Actors>
    <Steps><Require id="owned"><HasAbility actor="p" def="MetalbloodInjection" /></Require></Steps>
    <Success><StepSucceeded ref="owned" /></Success>
  </Case>
  <Case id="recovery" timeoutRealSeconds="60">
    <testDefName>Batch2_RecoveryAfterAllExpectedFailures</testDefName>
    <Scene /><Actors><Pawn id="p" x="20" z="20"><basePawnKind>SpaceRefugee</basePawnKind></Pawn></Actors>
    <Steps><Require id="alive"><ActorState actor="p" state="alive" /></Require><Screenshot id="recovered-image" focus="p" /></Steps>
    <Success><StepSucceeded ref="alive" /><StepSucceeded ref="recovered-image" /></Success>
  </Case>
</TestSuite>
