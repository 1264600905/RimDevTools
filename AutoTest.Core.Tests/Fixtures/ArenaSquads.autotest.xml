<ArenaSuite schemaVersion="1" id="arena.squads" gameVersion="1.7">
  <SquadTemplates>
    <SquadTemplate id="nativeRaid" source="faction" factionDef="PirateYttakin">
      <GroupMaker mode="random" kindDef="Combat" referencePoints="1500"/>
      <Xenotypes mode="inherit"/>
    </SquadTemplate>
    <SquadTemplate id="rangedRaid" source="faction" factionDef="Pirate">
      <GroupMaker mode="specific" kindDef="Combat" index="0" referencePoints="1500"/>
      <Xenotypes mode="fixed" def="Yttakin"/>
