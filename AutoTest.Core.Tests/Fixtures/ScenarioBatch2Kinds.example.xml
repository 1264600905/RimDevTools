  <Case id="TurretPocketMap" caseType="TurretPocketMap" timeoutRealSeconds="90" seed="31981">
    <testDefName>Batch2_TurretPocketMap_CustomDamage</testDefName>
    <Scene />
    <Teams>
      <Team id="a" factionDef="player" />
      <Team id="b" factionDef="AncientsHostile" />
    </Teams>
    <Actors>
      <Building def="Turret_MiniTurret" stuff="Steel" team="a" x="20" z="20" id="attacker" />
      <Building def="LogSync_AutoTestPowerGenerator" team="a" x="19" z="20" id="generator" />
      <Pawn id="target" team="b" x="27" z="20">
        <basePawnKind>SpaceRefugee</basePawnKind>
        <Hediffs>
          <Ensure def="LogSync_TurretTestTarget" severity="1" />
        </Hediffs>
      </Pawn>
    </Actors>
    <Steps>
      <DebugAction id="fuel" actionId="native.refuel">
        <Select mode="single" actor="attacker" />
      </DebugAction>
      <Wait id="powered" timeoutRealSeconds="10">
        <ComponentState actor="attacker" component="power" state="true" />
      </Wait>
      <Attack id="attack" actor="attacker" target="target" melee="false" />
      <Wait id="damage" timeoutRealSeconds="20">
        <HealthPercent actor="target" max="0.99999" />
      </Wait>
      <Screenshot id="image" focus="target" />
    </Steps>
    <Success>
      <StepSucceeded ref="damage" />
      <StepSucceeded ref="image" />
    </Success>
  </Case>
