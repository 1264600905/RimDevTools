      </Require>
      <Checkpoint id="before-drop" />
      <DropInventory id="drop" actor="pawn" target="steel" />
      <Require id="same">
        <ActorState actor="steel" state="spawned" />
        <Not>
          <ThingExists def="Steel" transition="added" since="before-drop" />
        </Not>
      </Require>
      <Destroy id="destroy" actor="steel" />
      <Require id="gone">
        <ActorState actor="steel" state="destroyed" />
      </Require>
    </Steps>
    <Success>
      <StepSucceeded ref="held" />
      <StepSucceeded ref="same" />
      <StepSucceeded ref="gone" />
    </Success>
  </Case>
