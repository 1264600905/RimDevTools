  <Case id="corpse" caseType="CorpseLifecycle" timeoutRealSeconds="90">
    <testDefName>Batch2_CorpseRotAndSamePawnResurrection</testDefName>
    <Scene />
    <Actors>
      <Corpse id="corpse" x="20" z="20">
        <basePawnKind>SpaceRefugee</basePawnKind>
      </Corpse>
    </Actors>
    <Steps>
      <Require id="dead">
        <ActorState actor="corpse.innerPawn" state="dead" />
        <CorpseState actor="corpse" state="valid" />
      </Require>
      <SetRot id="rot" actor="corpse" state="Rotting" />
      <Require id="rotten">
        <ComponentState actor="corpse" component="rot" state="Rotting" />
      </Require>
      <Resurrect id="revive" actor="corpse" />
      <Require id="alive">
        <ActorState actor="corpse.innerPawn" state="alive" />
        <ActorState actor="corpse.innerPawn" state="spawned" />
        <CorpseState actor="corpse" state="destroyed" />
      </Require>
      <Screenshot id="resurrection-image" focus="corpse.innerPawn" />
    </Steps>
    <Success>
      <StepSucceeded ref="rotten" />
      <StepSucceeded ref="alive" />
    </Success>
  </Case>
  <Case id="inventory" caseType="ThingBehavior" timeoutRealSeconds="90">
