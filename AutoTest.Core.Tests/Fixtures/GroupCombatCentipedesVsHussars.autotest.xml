<TestSuite schemaVersion="1" id="benchmark.centipedes-hussars" gameVersion="1.7">
  <Templates>
    <PawnTemplate id="charge-centipede">
      <basePawnKind>Mech_CentipedeBlaster</basePawnKind>
      <Hediffs mode="replace"/>
    </PawnTemplate>
    <PawnTemplate id="hussar-knight">
      <basePawnKind>Colonist</basePawnKind>
      <minGenerationAge>25</minGenerationAge><maxGenerationAge>25</maxGenerationAge>
      <Xenotype def="Hussar"/>
      <Traits mode="replace">
        <Set def="Tough" degree="0"/>
        <Set def="ShootingAccuracy" degree="-1"/>
      </Traits>
      <Skills mode="patch"><Set def="Shooting" level="10" passion="None"/></Skills>
      <Apparel mode="replace">
        <Add def="Apparel_ArmorCataphract" quality="Normal"/>
        <Add def="Apparel_ArmorHelmetCataphract" quality="Normal"/>
      </Apparel>
      <Equipment mode="replace"><SetPrimary def="Gun_Minigun" quality="Normal"/></Equipment>
      <Hediffs mode="replace"><Ensure def="Metalblood" severity="1"/></Hediffs>
    </PawnTemplate>
  </Templates>
  <Case id="twenty-vs-twenty" kind="groupCombat" name="20电荷蜈蚣对20钢血骑士甲骠骑速射机枪手" seed="12345" timeoutRealSeconds="300">
    <testDefName>Centipedes20VsHussars20_Minigun</testDefName>
    <Scene type="mainMap" generatorDef="LogSync_AutoTestStudioMap" sizeX="100" sizeZ="100" revealFog="all">
      <Environment weather="Clear" temperature="21" roof="none" naturalSun="true"/>
    </Scene>
    <Teams>
      <Team id="centipedes" name="电荷蜈蚣" ai="assaultColony"/>
      <Team id="hussars" name="钢血骑士甲骠骑种" ai="assaultColony"/>
    </Teams>
    <Actors>
      <PawnGroup id="centipedes" template="charge-centipede" team="centipedes" count="20" originX="22" originZ="40" formation="grid" columns="4" spacing="3"/>
      <PawnGroup id="hussars" template="hussar-knight" team="hussars" count="20" originX="62" originZ="40" formation="grid" columns="4" spacing="3"/>
    </Actors>
    <Steps>
      <Require id="roster-and-loadout">
        <All>
          <ActorCount group="centipedes" equals="20"/>
          <ActorCount group="hussars" equals="20"/>
          <HasXenotype actor="hussars" def="Hussar"/>
          <SkillLevel actor="hussars" def="Shooting" min="10" max="10"/>
          <HasTrait actor="hussars" def="Tough" degree="0"/>
          <HasTrait actor="hussars" def="ShootingAccuracy" degree="-1"/>
          <Wearing actor="hussars" def="Apparel_ArmorCataphract"/>
          <Wearing actor="hussars" def="Apparel_ArmorHelmetCataphract"/>
          <Equipped actor="hussars" def="Gun_Minigun"/>
          <HasHediff actor="hussars" def="Metalblood" quantifier="all"/>
          <Equipped actor="centipedes" def="Gun_ChargeBlasterHeavy"/>
        </All>
      </Require>
    </Steps>
    <GroupCombat durationSeconds="180" timeSpeed="normal"/>
    <Output purpose="benchmark" showAllParticipants="true"/>
  </Case>
</TestSuite>
