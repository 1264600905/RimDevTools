<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Report tests link runtime data holders; unrelated game-only fields stay unset. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\source\AutoTestRunner\Contracts\**\*.cs" Link="Contracts\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\source\AutoTestRunner\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\**\*.cs" Link="Scenarios\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\source\AutoTestRunner\AutoTestModels.cs" Link="Reporting\AutoTestModels.cs" />
    <Compile Include="..\source\AutoTestRunner\AutoTestReportWriter.cs" Link="Reporting\AutoTestReportWriter.cs" />
  </ItemGroup>
</Project>
