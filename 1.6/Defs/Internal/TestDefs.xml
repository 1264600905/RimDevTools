<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 测试专用：空口袋地图生成器 -->
  <MapGeneratorDef>
    <defName>LogSync_AutoTestPocketMap</defName>
    <label>log sync auto test pocket map</label>
    <disableCallAid>true</disableCallAid>
    <pocketMapProperties>
      <biome>Underground</biome>
      <temperature>15</temperature>
      <canBeCleaned>true</canBeCleaned>
    </pocketMapProperties>
    <genSteps>
      <!-- 基础步骤，用于初始化地图数据结构 -->
      <li>ElevationFertility</li>
      <!-- 确保有地形网格 -->
      <li>Terrain</li>
      <!-- 用石头填充地图，防止全空虚空 -->
      <li>RocksFromGrid</li>
      <!-- 清理可能残留的雾气 -->
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <!-- 测试专用：大功率发电机 -->
  <ThingDef>
    <defName>LogSync_AutoTestPowerGenerator</defName>
    <label>Auto-Test Power Generator</label>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>UI/Buttons/Dev/Add</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>9999</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>1.0</fillPercent>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <WorkToBuild>0</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-200000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
    </comps>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- 测试专用：口袋地图入口 -->
  <ThingDef>
    <defName>LogSync_AutoTestPortal</defName>
    <label>Auto-Test Portal</label>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>UI/Buttons/Dev/Add</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <color>(1,0.5,1)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <WorkToBuild>0</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <size>(1,1)</size>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- 测试专用：靶子 Hediff -->
  <HediffDef>
    <defName>LogSync_TurretTestTarget</defName>
    <label>Auto-Test Target Buff</label>
    <description>Reduces move speed to 10% and incoming damage to 10%.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.5, 1.0)</defaultLabelColor>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.1</postFactor>
          </li>
        </capMods>
        <statOffsets>
          <IncomingDamageFactor>-0.9</IncomingDamageFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
