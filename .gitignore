*.dll

# 保留特定目录结构
bin/Debug/

# 参考文档不允许提交
参考文档/
Reference_Documentation/
# 代码混淆工具
ConfuserEx-CLI/
obfuscar-2.2.50/

# 忽略 CodeObfuscation 下的所有内容...
CodeObfuscation/*

# ...但保留 ObfuscarTarget 目录...
!CodeObfuscation/ObfuscarTarget/

# ...忽略 ObfuscarTarget 下的所有内容...
CodeObfuscation/ObfuscarTarget/*

# ...但最终保留 config.xml
!CodeObfuscation/ObfuscarTarget/config.xml
