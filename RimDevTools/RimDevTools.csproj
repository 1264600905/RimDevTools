<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>Latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RimDevTools</AssemblyName>
    <RootNamespace>RimDevTools</RootNamespace>
    <Version>1.5.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\source\AutoTestRunner\Core\AutoTestResultStatus.cs" Link="Shared\AutoTestResultStatus.cs" />
    <Compile Include="..\source\AutoTestRunner\Core\TestArtifactDirectory.cs" Link="Shared\TestArtifactDirectory.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\ScenarioContracts.cs" Link="Shared\ScenarioContracts.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\ScenarioLoader.cs" Link="Shared\ScenarioLoader.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\ScenarioCaseInheritance.cs" Link="Shared\ScenarioCaseInheritance.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\ScenarioExpansion.cs" Link="Shared\ScenarioExpansion.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\ScenarioPlanner.cs" Link="Shared\ScenarioPlanner.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\ScenarioDebugActions.cs" Link="Shared\ScenarioDebugActions.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\ScenarioActionBindings.cs" Link="Shared\ScenarioActionBindings.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\ScenarioViews.cs" Link="Shared\ScenarioViews.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\TemporaryPawnData.cs" Link="Shared\TemporaryPawnData.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\GroupCombatContracts.cs" Link="Shared\GroupCombatContracts.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\GroupCombatLoader.cs" Link="Shared\GroupCombatLoader.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\CombatRoster.cs" Link="Shared\CombatRoster.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\ArenaContracts.cs" Link="Shared\ArenaContracts.cs" />
    <Compile Include="..\source\AutoTestRunner\Scenarios\ArenaLoader.cs" Link="Shared\ArenaLoader.cs" />
  </ItemGroup>
</Project>
