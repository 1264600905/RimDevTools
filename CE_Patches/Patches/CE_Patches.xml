<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- ========== 脚架系统定义 ========== -->
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs</xpath>
		<value>
			<CombatExtended.BipodCategoryDef>
				<defName>bipod2A72</defName>
				<label>2A72脚架</label>
				<bipod_id>Bipod_2A72</bipod_id>
				<ad_Range>5</ad_Range>
				<setuptime>360</setuptime>
				<recoil_mult_setup>0.473</recoil_mult_setup>
				<recoil_mult_NOT_setup>1.0</recoil_mult_NOT_setup>
				<warmup_mult_setup>0.394</warmup_mult_setup>
				<warmup_mult_NOT_setup>1.0</warmup_mult_NOT_setup>
				<logColor>(255, 165, 0)</logColor>
				<swayMult>0.306</swayMult>
				<swayPenalty>1.0</swayPenalty>
				<autosetMode>AimedShot</autosetMode>
				<useAutoSetMode>true</useAutoSetMode>
			</CombatExtended.BipodCategoryDef>
		</value>
	</Operation>

	<!-- ========== 2A72 重型狙击枪 ========== -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Weapon_2A7Two</defName>
		<statBases>
			<Mass>35</Mass>
			<RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown>
			<SightsEfficiency>3.3</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>1.53</SwayFactor>
			<Bulk>32</Bulk>
		</statBases>
		<costList>
			<Tungsteel>110</Tungsteel>
			<ComponentStamped>5</ComponentStamped>
		</costList>
		<Properties>
			<recoilAmount>2.84</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_30x165mm_AP</defaultProjectile>
			<warmupTime>3.15</warmupTime>
			<range>95</range>
			<burstShotCount>1</burstShotCount>
			<ticksBetweenBurstShots>1</ticksBetweenBurstShots>
			<soundCast>Shot_SniperRifle</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>12</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>5</magazineSize>
			<reloadTime>6</reloadTime>
			<ammoSet>AmmoSet_30x165mm</ammoSet>
		</AmmoUser>
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_AI_SniperRifle</li>
			<li>Bipod_2A72</li>
		</weaponTags>
	</Operation>

	<!-- ========== 2A72 近战工具 ========== -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Weapon_2A7Two"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>stock</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>18</power>
					<cooldownTime>2</cooldownTime>
					<chanceFactor>0.2</chanceFactor>
					<armorPenetrationBlunt>4</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>barrel</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>4</power>
					<cooldownTime>2</cooldownTime>
					<armorPenetrationBlunt>1</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

