<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- ========== 突击战斗服CE补丁 ========== -->
		<!-- 重写材质护甲值以适配CE系统 -->

		<Operation Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="Apparel_AssaultCombatSuit"]/statBases/StuffEffectMultiplierArmor</xpath>
			<value>
				<StuffEffectMultiplierArmor>15</StuffEffectMultiplierArmor>
			</value>
		</Operation>
	<!-- 添加CE特有属性 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Apparel_AssaultCombatSuit"]/statBases</xpath>
		<value>
			<Bulk>120</Bulk>
			<WornBulk>80</WornBulk>
		</value>
	</Operation>
	
		<!-- 添加携带能力和抗压制能力 -->
		<Operation Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Apparel_AssaultCombatSuit"]/equippedStatOffsets</xpath>
			<value>
				<CarryWeight>10</CarryWeight>
				<Suppressability>0.8</Suppressability>
			</value>
		</Operation>

	<!-- 添加CE护甲扩展 -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="Apparel_AssaultCombatSuit"]</xpath>
		<value>
			<li Class="CombatExtended.PartialArmorExt">
				<stats>
					<li>
						<ArmorRating_Sharp>1.25</ArmorRating_Sharp>
						<parts>
							<li>Torso</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>1.25</ArmorRating_Blunt>
						<parts>
							<li>Torso</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.8</ArmorRating_Sharp>
						<parts>
							<li>Neck</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.8</ArmorRating_Blunt>
						<parts>
							<li>Neck</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.6</ArmorRating_Sharp>
						<parts>
							<li>Shoulder</li>
							<li>Arm</li>
							<li>Leg</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.6</ArmorRating_Blunt>
						<parts>
							<li>Shoulder</li>
							<li>Arm</li>
							<li>Leg</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.28</ArmorRating_Sharp>
						<parts>
							<li>Hand</li>
							<li>Foot</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.28</ArmorRating_Blunt>
						<parts>
							<li>Hand</li>
							<li>Foot</li>
						</parts>
					</li>
				</stats>
			</li>
		</value>
	</Operation>
	
	<!-- ========== 特种防护头盔CE补丁 ========== -->
	
	<!-- 添加CE特有属性 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Apparel_SpecialProtectionHelmet"]/statBases</xpath>
		<value>
			<Bulk>8</Bulk>
			<WornBulk>10</WornBulk>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Apparel_SpecialProtectionHelmet"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>13.0</StuffEffectMultiplierArmor>
		</value>
	</Operation>
	<!-- 添加CE护甲扩展 -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="Apparel_SpecialProtectionHelmet"]</xpath>
		<value>
			<li Class="CombatExtended.PartialArmorExt">
				<stats>
					<li>
						<ArmorRating_Sharp>0.6</ArmorRating_Sharp>
						<parts>
							<li>Eye</li>
							<li>Nose</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.6</ArmorRating_Blunt>
						<parts>
							<li>Eye</li>
							<li>Nose</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.6</ArmorRating_Sharp>
						<parts>
							<li>Jaw</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Blunt>0.6</ArmorRating_Blunt>
						<parts>
							<li>Jaw</li>
						</parts>
					</li>
				</stats>
			</li>
		</value>
	</Operation>
	
	<!-- ========== 胸挂加固电脑CE补丁 ========== -->
	
	<!-- 添加CE特有属性 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Apparel_ChestMountedComputer"]/statBases</xpath>
		<value>
			<Bulk>4</Bulk>
			<WornBulk>5</WornBulk>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Apparel_ChestMountedComputer"]/apparel/layers</xpath>
		<value>
			<layers>
				<li>Webbing</li>
			</layers>
		</value>
	</Operation>
</Patch>
