<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MyCustomMod</AssemblyName>
    <RootNamespace>MyCustomMod</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''"></RimWorldDir>
    <RimWorldAssemblyDir Condition="'$(RimWorldAssemblyDir)' == ''">$(RimWorldDir)</RimWorldAssemblyDir>
    <HarmonyDllPath Condition="'$(HarmonyDllPath)' == ''"></HarmonyDllPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldAssemblyDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldAssemblyDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldAssemblyDir)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDllPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateRimWorldReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RimWorldDir)' == ''" Text="RimWorldDir is required. Run RimDevTools deploy or pass -p:RimWorldDir=&lt;RimWorld installation&gt;." />
    <Error Condition="'$(RimWorldAssemblyDir)' == '' or !Exists('$(RimWorldAssemblyDir)\Assembly-CSharp.dll')" Text="RimWorldAssemblyDir must contain the RimWorld 1.7 assemblies." />
    <Error Condition="!Exists('$(RimWorldAssemblyDir)\UnityStubs.dll') or !Exists('$(RimWorldAssemblyDir)\Waylith.dll')" Text="RimWorldAssemblyDir must contain UnityStubs.dll and Waylith.dll." />
    <Error Condition="'$(HarmonyDllPath)' == '' or !Exists('$(HarmonyDllPath)')" Text="HarmonyDllPath must point to the 1.7 0Harmony.dll selected by RimDevTools." />
  </Target>
</Project>
