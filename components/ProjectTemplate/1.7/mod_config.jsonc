{
  "config_version": 2,
  "mod_name": "TempProject",
  "game_version": "1.7",
  "isolated_desktop": true,
  "rimsearcher_db_path": ".tools\\db\\defs.db",
  "rimworld_dir": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\RimWorld",
  "workshop_paths": [],
  "csproj_paths": ["source\\TempProject\\TempProject.csproj"],
  "sync_items": [
    "1.7\\Assemblies",
    "1.7\\Defs",
    "1.7\\Patches",
    "Languages",
    "About",
    "LoadFolders.xml"
  ],
  "protected_files_regex": "^(PublishedFileId\\.txt)$",
  "pull_ignore_folders": ["Textures", "Sounds", "News", ".git", ".vs", "obj", "bin"],
  "ilspycmd_path": "Ilspy\\ilspycmd.exe",
  "log_keywords": ["TempProject"],
  "min_active_mods": ["brrainz.harmony", "ludeon.rimworld"],
  "timeouts": {
    "steam_launch_detect": 120,
    "max_wait": 600,
    "existing_game_exit": 600,
    "post_exit_delay": 10
  },
  "retention": {
    "max_log_files": 3,
    "max_auto_test_runs": 3
  },
  "shader_bundle": {
    "enabled": false,
    "unity_project_path": "UnityProjects\\ShaderBundleBuilder",
    "unity_exe_path": "",
    "build_method": "TempProject.ShaderBundleBuilder.Build",
    "bundle_name": "tempproject_shaders"
  }
}
