<?xml version="1.0" encoding="utf-8"?>
<!-- Rename Template_Recipe and Template_Product; verify work stats and recipe user for the intended workstation. -->
<Defs>
  <RecipeDef>
    <defName>Template_Recipe</defName>
    <label>make template product</label>
    <description>Craft a template product.</description>
    <jobString>Making template product.</jobString>
    <workAmount>6000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Template_Product>1</Template_Product>
    </products>
    <recipeUsers>
      <li>TableMachining</li>
    </recipeUsers>
  </RecipeDef>
</Defs>
