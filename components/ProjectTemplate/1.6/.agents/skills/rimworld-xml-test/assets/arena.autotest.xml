<?xml version="1.0" encoding="utf-8"?>
<ArenaSuite schemaVersion="1" id="example.arena" gameVersion="1.7">
  <Tournament id="animals" name="五队动物战力预算擂台" seed="12345">
    <testDefName>Example_AnimalArena</testDefName>
    <Scene type="mainMap" generatorDef="LogSync_AutoTestStudioMap" sizeX="100" sizeZ="100" revealFog="all">
      <Environment weather="Clear" temperature="21" roof="none" naturalSun="true"/>
    </Scene>
    <Roster mode="combatPower" budget="1200" costMode="pawnKind"/>
