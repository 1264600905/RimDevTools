      <Showcase pageSeconds="5">
        <Page seconds="5" caption="动物战力对比">
          <Entrant ref="wolves"/><Entrant ref="bears"/><Entrant ref="wargs"/>
          <Entrant ref="cougars"/><Entrant ref="grizzlies"/>
        </Page>
      </Showcase>
    </Presentation>
    <Output width="1920" height="1080"/>
